@page
@model SMART_MALL_PARKING_SYSTEM.Pages.Admin.VehicleGateModel

@{
    ViewData["Title"] = "Vehicle Gate";

    bool paymentPending = Model.PaymentRequired;
    bool paymentCompleted =
        Model.DisplayMessage == "EXIT COMPLETED";

    bool paymentFailed =
        Model.DisplayMessage == "PAYMENT FAILED";
}

<div class="container mt-4">

    
    <!-- DIGITAL GATE DISPLAY -->
    <div class="card mb-4 border-dark shadow">

        <div class="card-header bg-dark text-white text-center">
            <h4 class="mb-0">
                SUMMIT USJ MALL PARKING - DIGITAL GATE DISPLAY
            </h4>
        </div>

        <div class="card-body text-center"
             style="background-color:#101c2c; color:white;">

            <h5>DETECTED VEHICLE NUMBER</h5>

            <h1 class="fw-bold text-info">
                @Model.DisplayPlate
            </h1>

            <hr class="border-light" />

            @if (Model.DisplayMessage == "PAYMENT REQUIRED")
            {
                <h1 class="display-5 fw-bold text-warning">
                    PAYMENT REQUIRED
                </h1>

                <h2 class="text-success mt-3">
                    @Model.DisplayFee
                </h2>

                <h4 class="text-warning mt-3">
                    GATE CLOSED
                </h4>
            }
            else if (Model.DisplayMessage == "PAYMENT FAILED")
            {
                <h1 class="display-5 fw-bold text-danger">
                    PAYMENT FAILED
                </h1>

                <h2 class="text-success mt-3">
                    @Model.DisplayFee
                </h2>

                <h4 class="text-danger mt-3">
                    GATE CLOSED
                </h4>
            }
            else if (Model.DisplayMessage == "EXIT COMPLETED")
            {
                <h1 class="display-5 fw-bold text-success">
                    PAYMENT SUCCESSFUL
                </h1>

                <h2 class="text-success mt-3">
                    @Model.DisplayFee
                </h2>

                <h4 class="text-success mt-3">
                    GATE OPENING...
                </h4>
            }
            else
            {
                <h5>ASSIGNED PARKING SPACE</h5>

                <h1 class="display-2 fw-bold text-success">
                    @Model.DisplaySpace
                </h1>

                <h4 class="mt-3">
                    @Model.DisplayMessage
                </h4>
            }

        </div>
    </div>


    <h1 class="mb-4">Vehicle Entry &amp; Exit Gate</h1>

    <a asp-page="/Admin/Dashboard"
       class="btn btn-secondary mb-4">
        ← Back to Dashboard
    </a>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- PARKING CAPACITY -->
    <div class="row mb-4">

        <div class="col-md-6 mb-3">
            <div class="card border-primary text-center">
                <div class="card-body">
                    <h5>Vehicles Inside</h5>
                    <h2>@Model.VehiclesInside</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card border-success text-center">
                <div class="card-body">
                    <h5>Remaining Gate Capacity</h5>
                    <h2>@Model.RemainingCapacity</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- VEHICLE ENTRY AND EXIT -->
    <div class="card mb-4">
        <div class="card-body">

            <h4 class="mb-3">Simulated Vehicle Gate</h4>

            <p class="text-muted">
                Enter a vehicle number to simulate entry
                or begin the exit payment process.
            </p>

            <form method="post">

                <div class="mb-3">
                    <label asp-for="VehicleNumber"
                           class="form-label">
                        Vehicle Number
                    </label>

                    <input asp-for="VehicleNumber"
                           class="form-control"
                           placeholder="Example: ABC1234"
                           maxlength="20"
                           required />

                    <span asp-validation-for="VehicleNumber"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        asp-page-handler="Entry"
                        class="btn btn-success me-2">
                    Simulate Entry
                </button>

                <button type="submit"
                        asp-page-handler="Exit"
                        class="btn btn-danger">
                    Simulate Exit
                </button>

            </form>
        </div>
    </div>

    <!-- PAYMENT SECTION -->
    @if (paymentPending)
    {
        <div class="card border-warning shadow mb-4">

            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">
                    <i class="bi bi-credit-card"></i>
                    Parking Payment Required
                </h4>
            </div>

            <div class="card-body">

                <div class="alert alert-info">
                    This is an FYP payment simulation.
                    No real banking transaction or card charge
                    will take place.
                </div>

                <h5>
                    Vehicle:
                    <strong>@Model.PaymentPlate</strong>
                </h5>

                <h5>
                    Amount Due:
                    <strong class="text-danger">
                        RM @Model.PaymentAmount
                    </strong>
                </h5>

                <p class="text-muted">
                    Choose a payment method below.
                    The vehicle will remain inside until
                    payment is approved.
                </p>

                <div class="row g-3 mt-2">

                    <!-- FPX -->
                    <div class="col-md-4">
                        <div class="card h-100 text-center">
                            <div class="card-body">

                                <h5>FPX Online Banking</h5>

                                <p class="text-muted">
                                    Simulate payment using
                                    Malaysian online banking.
                                </p>

                                <form method="post"
                                      asp-page-handler="Payment">

                                    <input type="hidden"
                                           name="VehicleNumber"
                                           value="@Model.PaymentPlate" />

                                    <input type="hidden"
                                           name="paymentMethod"
                                           value="FPX" />

                                    <input type="hidden"
                                           name="approved"
                                           value="true" />

                                    <button type="submit"
                                            class="btn btn-primary w-100">
                                        Simulate FPX Payment
                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>

                    <!-- DEBIT CARD -->
                    <div class="col-md-4">
                        <div class="card h-100 text-center">
                            <div class="card-body">

                                <h5>Debit Card</h5>

                                <p class="text-muted">
                                    Simulate debit card
                                    terminal approval.
                                </p>

                                <form method="post"
                                      asp-page-handler="Payment">

                                    <input type="hidden"
                                           name="VehicleNumber"
                                           value="@Model.PaymentPlate" />

                                    <input type="hidden"
                                           name="paymentMethod"
                                           value="DebitCard" />

                                    <input type="hidden"
                                           name="approved"
                                           value="true" />

                                    <button type="submit"
                                            class="btn btn-success w-100">
                                        Simulate Debit Card
                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>

                    <!-- CREDIT CARD -->
                    <div class="col-md-4">
                        <div class="card h-100 text-center">
                            <div class="card-body">

                                <h5>Credit Card</h5>

                                <p class="text-muted">
                                    Simulate credit card
                                    terminal approval.
                                </p>

                                <form method="post"
                                      asp-page-handler="Payment">

                                    <input type="hidden"
                                           name="VehicleNumber"
                                           value="@Model.PaymentPlate" />

                                    <input type="hidden"
                                           name="paymentMethod"
                                           value="CreditCard" />

                                    <input type="hidden"
                                           name="approved"
                                           value="true" />

                                    <button type="submit"
                                            class="btn btn-success w-100">
                                        Simulate Credit Card
                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>

                </div>

                <!-- FAILED PAYMENT TEST -->
                <div class="mt-4 border-top pt-3">

                    <h6>Payment Failure Test</h6>

                    <p class="text-muted">
                        Test what happens when a card
                        payment is declined.
                    </p>

                    <form method="post"
                          asp-page-handler="Payment">

                        <input type="hidden"
                               name="VehicleNumber"
                               value="@Model.PaymentPlate" />

                        <input type="hidden"
                               name="paymentMethod"
                               value="DebitCard" />

                        <input type="hidden"
                               name="approved"
                               value="false" />

                        <button type="submit"
                                class="btn btn-outline-danger">
                            Simulate Declined Debit Card Payment
                        </button>
                    </form>

                </div>

            </div>
        </div>
    }

    <!-- RECENT VEHICLE RECORDS -->
    <h4 class="mb-3">Recent Vehicle Records</h4>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead class="table-dark">
                <tr>
                    <th>Vehicle</th>
                    <th>Entry Time</th>
                    <th>Exit Time</th>
                    <th>Status</th>
                    <th>Space Assigned</th>
                    <th>Parking Fee (RM)</th>
                    <th>Payment Method</th>
                    <th>Payment Status</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var entry in Model.RecentEntries)
                {
                    <tr>
                        <td>@entry.VehicleNumber</td>

                        <td>
                            @entry.EntryTime.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @(entry.ExitTime.HasValue
                                ? entry.ExitTime.Value.ToString(
                                    "dd/MM/yyyy HH:mm")
                                : "-")
                        </td>

                        <td>
                            @entry.Status
                        </td>

                        <td>
                            @if (entry.IsSpaceAssigned &&
                                 entry.ParkingSpaceId.HasValue &&
                                 Model.RecentSpaceLabels.TryGetValue(
                                     entry.ParkingSpaceId.Value,
                                     out var location))
                            {
                                <strong>@location</strong>
                            }
                            else
                            {
                                <span class="text-muted">Not assigned</span>
                            }
                        </td>

                        <td class="fw-bold">
                            @if (entry.Fee.HasValue)
                            {
                                <span class="text-success">
                                    RM @entry.Fee.Value.ToString("0.00")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Pending
                                </span>
                            }
                        </td>

                        @{
                            var hasPayment = Model.RecentPayments.TryGetValue(
                                entry.VehicleEntryId,
                                out var payment);
                        }

                        <td>
                            @if (hasPayment && payment != null)
                            {
                                if (payment.PaymentMethod == "FPX")
                                {
                                    <span>FPX Online Banking</span>
                                }
                                else if (payment.PaymentMethod == "DebitCard")
                                {
                                    <span>Debit Card</span>
                                }
                                else if (payment.PaymentMethod == "CreditCard")
                                {
                                    <span>Credit Card</span>
                                }
                                else
                                {
                                    <span>@payment.PaymentMethod</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>

                        <td>
                            @if (hasPayment && payment != null)
                            {
                                if (payment.PaymentStatus == "Successful")
                                {
                                    <span class="badge bg-success">
                                        Successful
                                    </span>
                                }
                                else if (payment.PaymentStatus == "Failed")
                                {
                                    <span class="badge bg-danger">
                                        Failed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @payment.PaymentStatus
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    No Payment
                                </span>
                            }
                        </td>

                    </tr>
                }

                @if (Model.RecentEntries.Count == 0)
                {
                    <tr>
                        <td colspan="8"
                            class="text-center text-muted">
                            No vehicle records yet.
                        </td>
                    </tr>
                }

            </tbody>

        </table>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
