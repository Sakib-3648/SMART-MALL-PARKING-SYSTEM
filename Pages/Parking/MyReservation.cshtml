@page
@model SMART_MALL_PARKING_SYSTEM.Pages.Parking.MyReservationModel

@{
    ViewData["Title"] = "My Reservations";
}

<div class="container mt-5">

    <h1 class="mb-4">My Reservations</h1>

    <div class="mb-3">
        <a asp-page="/Index" class="btn btn-secondary">
            ← Back to Home
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model.Reservations.Count == 0)
    {
        <div class="alert alert-info">
            You have no reservations.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Original Reserved Space</th>
                        <th>Actual Assigned Space</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reservation in Model.Reservations)
                    {
                        var originalSpace =
                            reservation.ParkingSpace?.SpaceNumber ?? "Unknown";

                        bool hasGateAssignment =
                            Model.ActualAssignedSpaces.TryGetValue(
                                reservation.ParkingReservationId,
                                out var assignedSpace);

                        bool isAlternative =
                            hasGateAssignment &&
                            !string.Equals(
                                originalSpace,
                                assignedSpace,
                                StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td>
                                <strong>@originalSpace</strong>

                                @if (isAlternative)
                                {
                                    <div class="mt-1">
                                        <span class="badge bg-warning text-dark">
                                            Unavailable - Reassigned
                                        </span>
                                    </div>
                                }
                            </td>

                            <td>
                                @if (hasGateAssignment)
                                {
                                    <strong class="text-success">
                                        @assignedSpace
                                    </strong>

                                    @if (isAlternative)
                                    {
                                        <div class="small text-muted mt-1">
                                            Your original space was unavailable.
                                            The smart gate assigned this
                                            alternative parking space.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted mt-1">
                                            Assigned by vehicle gate
                                        </div>
                                    }
                                }
                                else if (reservation.Status == "Started")
                                {
                                    <span class="text-muted">
                                        Check My Parking
                                    </span>
                                }
                                else if (reservation.Status == "Reserved")
                                {
                                    <span class="text-muted">
                                        Not assigned yet
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                            </td>

                            <td>
                                @reservation.ReservationStart.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @reservation.ReservationEnd.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @if (reservation.Status == "Reserved")
                                {
                                    <span class="badge bg-primary">
                                        Reserved
                                    </span>
                                }
                                else if (reservation.Status == "Started")
                                {
                                    <span class="badge bg-success">
                                        Started
                                    </span>
                                }
                                else if (reservation.Status == "Completed")
                                {
                                    <span class="badge bg-secondary">
                                        Completed
                                    </span>
                                }
                                else if (reservation.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                }
                                else if (reservation.Status == "Expired")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Expired
                                    </span>
                                }
                                else
                                {
                                    @reservation.Status
                                }
                            </td>

                            <td>
                                @if (reservation.Status == "Reserved")
                                {
                                    
@*
    Manual Start Parking is hidden.

    The Vehicle Gate automatically processes
    reservations when the vehicle enters.

    @if (DateTime.Now >= reservation.ReservationStart &&
         DateTime.Now <= reservation.ReservationEnd)
    {
        <form method="post"
              asp-page-handler="StartParking"
              class="mb-1">

            <input type="hidden"
                   name="reservationId"
                   value="@reservation.ParkingReservationId" />

            <button type="submit"
                    class="btn btn-success btn-sm">
                Start Parking
            </button>
        </form>
    }
*@


                                    <form method="post"
                                          asp-page-handler="Cancel">

                                        <input type="hidden"
                                               name="reservationId"
                                               value="@reservation.ParkingReservationId" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to cancel this reservation?');">
                                            Cancel
                                        </button>
                                    </form>
                                }
                                else if (reservation.Status == "Started")
                                {
                                    <a asp-page="/Parking/MyParking"
                                       class="btn btn-outline-primary btn-sm">
                                        View My Parking
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No action
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
</div>
