@page
@model IndexModel

@{
    ViewData["Title"] = "Home";
}

<div class="text-center" style="font-size: 20px;">

    @if (Model.UserId != null)
    {
        <p class="text-success">
            Welcome back, <strong>@Model.FullName</strong>!
        </p>

        <p>
            Vehicle Number:
            <strong>@Model.VehicleNumber</strong>
        </p>

        <p>
            Current Parking:
            <strong>
                @if (Model.CurrentParkingStatus == "Active")
                {
                    @($"{Model.CurrentParkingSpace} — Active")
                }
                else
                {
                    @Model.CurrentParkingStatus
                }
            </strong>
        </p>

        @if (Model.CurrentParkingStatus == "Active")
        {
            <p>
                Parking Duration:
                <strong>@Model.ParkingDuration</strong>
            </p>

            <p>
                Estimated Fee:
                <strong>RM @Model.CurrentFee.ToString("0.00")</strong>
            </p>
        }
    }

    @if (Model.UserId == null)
    {
        <div class="mt-3">
            <a class="btn btn-primary m-1" href="/Login">
                Login
            </a>

            <a class="btn btn-success m-1" href="/Register">
                Register
            </a>
        </div>
    }
    else
    {
        <div class="mt-3">
            <a class="btn btn-primary m-1"
               href="/Parking/Availability">
                Find Parking
            </a>

            <a class="btn btn-warning m-1"
               href="/Parking/Reserve">
                Reserve Parking
            </a>

            <a class="btn btn-info m-1"
               href="/Parking/MyReservation">
                My Reservations
            </a>

            <a class="btn btn-success m-1"
               href="/Parking/MyParking">
                My Parking
            </a>

            <a class="btn btn-secondary m-1"
               href="/Parking/History">
                Parking History
            </a>

            <a class="btn btn-danger m-1"
               href="/Logout">
                Logout
            </a>
        </div>
    }

</div>
